{
  "name": "@digital-go-jp/design-system-example-components",
  "version": "1.4.2",
  "type": "module",
  "main": "dist/index.cjs.js",
  "typings": "dist/index.d.ts",
  "module": "dist/index.es.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs.js",
      "import": "./dist/index.es.js"
    }
  },
  "files": [
    "dist"
  ],
  "homepage": "https://github.com/digital-go-jp/design-system-example-components#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/digital-go-jp/design-system-example-components"
  },
  "bugs": {
    "url": "https://github.com/digital-go-jp/design-system-example-components/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "license": "MIT",
  "scripts": {
    "build": "tsc && vite build",
    "format": "biome format --write src",
    "lint": "biome lint src",
    "lint:fix": "biome check --apply src",
    "lint:markup": "markuplint \"./src/**/*.{jsx,tsx}\"",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "storybook:test": "test-storybook",
    "test": "vitest"
  },
  "dependencies": {
    "@digital-go-jp/tailwind-theme-plugin": "^0.3.4",
    "@radix-ui/react-slot": "^1.2.4",
    "@storybook/addon-themes": "^10.2.19",
    "cva": "^1.0.0-beta.1",
    "react": "^19.2.4",
    "react-aria-components": "^1.16.0",
    "react-dom": "^19.2.4",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "tailwindcss-react-aria-components": "^2.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.7",
    "@markuplint/jsx-parser": "^4.7.23",
    "@markuplint/react-spec": "^4.5.23",
    "@storybook/addon-a11y": "^10.2.19",
    "@storybook/addon-docs": "^10.2.19",
    "@storybook/addon-links": "^10.2.19",
    "@storybook/react": "^10.2.19",
    "@storybook/react-vite": "^10.2.19",
    "@tailwindcss/postcss": "^4.2.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.4.27",
    "jsdom": "^28.1.0",
    "markuplint": "^4.14.1",
    "postcss": "^8.5.8",
    "react-docgen-typescript": "^2.4.0",
    "storybook": "^10.2.19",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.9.3",
    "vite": "^8.0.0",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": ">=18"
  },
  "engineStrict": true
}
